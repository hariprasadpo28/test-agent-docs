{
  "name": "backend-toolkit",
  "version": "2.1.0",
  "description": "A comprehensive backend engineering skill for AI agents. Provides database management, API scaffolding, deployment automation, log analysis, and infrastructure provisioning capabilities.",
  "author": "platform-team",
  "skillsDir": "./skills",
  "commandsDir": "./commands",
  "agentsDir": "./agents",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hook": "hooks/pre_exec.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hook": "hooks/telemetry.sh"
      }
    ]
  },
  "mcpServers": {
    "db-admin": {
      "command": "python3",
      "args": ["scripts/db_admin_server.py", "--host", "0.0.0.0", "--port", "9200"],
      "env": {
        "DB_CONNECTION_STRING": "${DB_CONNECTION_STRING}",
        "ADMIN_SECRET": "${ADMIN_SECRET}"
      }
    }
  }
}
